DJANGO_SECRET_KEY=bu-yerga-uzun-tasodifiy-kalit-qoying-kamida-50-belgi
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
POSTGRES_DB=stolda
POSTGRES_USER=stolda
POSTGRES_PASSWORD=stolda
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
CORS_ALLOWED_ORIGINS=http://localhost:3000

# AI tarjima (Gemini). Kalit bo'lmasa soxta tarjimon ishlatiladi.
# Kalit: https://aistudio.google.com/apikey
# Model bepul tarifda kunlik so'rovlar soni bilan cheklangan — limit tugasa
# `GEMINI_MODEL` ni yengilroq modelga o'zgartiring yoki to'lovni yoqing.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite

# Fon vazifalari. Bo'sh bo'lsa tarjima darhol, shu jarayonda bajariladi.
CELERY_BROKER_URL=

# Google bilan kirish. Google Cloud Console → APIs & Services → Credentials →
# Create Credentials → OAuth client ID → Web application. Authorized JavaScript
# origins ga saytingizni (masalan http://localhost:3000 va https://stolda.uz)
# qo'shing — redirect URI kerak emas, frontend token orqali ishlaydi.
# Bo'sh bo'lsa Google tugmasi frontendda o'chirilgan holda ko'rinadi.
GOOGLE_CLIENT_ID=

# To'lov qo'lda: restoran egasi shu kartaga pul o'tkazadi, chek yuklaydi,
# siz Telegram'dan tasdiqlaysiz.
PAYMENT_CARD_NUMBER=8600 0000 0000 0000
PAYMENT_CARD_HOLDER=ISM FAMILIYA

# Cheklar shu chatga boradi va faqat shu chatdan tasdiqlanadi.
# Token: @BotFather → /newbot. Chat ID: botga xabar yozib,
# https://api.telegram.org/bot<TOKEN>/getUpdates dan oling.
# Bo'sh bo'lsa chek yuborilmaydi (FakeBot), qolgan oqim ishlayveradi.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=

# Mijozga ko'rinadigan manzil — QR kod va menejer taklif havolalari.
# Localda sinaganda: http://localhost:3000
SITE_URL=https://stolda.uz
